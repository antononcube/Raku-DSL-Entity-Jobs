# use lib <. lib>;
use DSL::Entity::Jobs;
use Test;

my %targetToAction{Str} =
        "WL-System"   => DSL::Entity::Jobs::Actions::WL::System,
        "Raku-System" => DSL::Entity::Jobs::Actions::Raku::System;

my $focusTarget = 'WL-System';

##===========================================================
## Skills
##===========================================================

my $pCOMMAND = DSL::Entity::Jobs::Grammar;
$pCOMMAND.set-resources(DSL::Entity::Jobs::resource-access-object());

my $ACTOBJ = %targetToAction{$focusTarget}.new(resources => DSL::Entity::Jobs::resource-access-object());


plan *;

## 1
is $pCOMMAND.parse('java', rule => 'entity-job-skill', actions => $ACTOBJ).made,
        '"Java"',
        'java';

## 2
is $pCOMMAND.parse('java developmnt', rule => 'entity-job-skill', actions => $ACTOBJ).made,
        '"JavaDevelopment"',
        'java developmnt (misspelled)';

## 3
is $pCOMMAND.parse('continuous integration', rule => 'entity-job-skill', actions => $ACTOBJ).made,
        '"ContinuousIntegration"',
        'continuous integration';

## 4
is $pCOMMAND.parse('customer service', rule => 'entity-job-skill', actions => $ACTOBJ).made,
        '"CustomerService"',
        'customer service';

## 5
is $pCOMMAND.parse('mobile application development', rule => 'entity-job-skill', actions => $ACTOBJ).made,
        '"MobileApplicationDevelopment"',
        'mobile application development';

## 6
subtest {
    is ToJobEntityCode('java development'), '"JavaDevelopment"', 'java development';
    is ToJobEntityCode('quality assurance'), '"QualityAssurance"', 'quality assurance';
    is ToJobEntityCode('quality management'), '"QualityManagement"',  'quality management';
}, 'top-level call';

## 6
subtest {
    is ToJobEntityCode('java development', $focusTarget), '"JavaDevelopment"', 'java development';
    is ToJobEntityCode('quality assurance', $focusTarget), '"QualityAssurance"', 'quality assurance';
    is ToJobEntityCode('quality management', $focusTarget), '"QualityManagement"',  'quality management';
}, 'top-level call, specific target';

done-testing;
